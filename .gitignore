# Python
__pycache__/
*.pyc

# Local run logs
logs/

# Raw snapshots: ~1 MB per day, so ~300 MB per year if committed.
# Keep them out of git; archive elsewhere (object storage / cloud drive) if needed.
data/raw/

# Generated by build scripts; CI regenerates them on every run
site/data/teci.js
site/data/i18n.js
publish/

# Single-file build output: regenerated daily, not worth committing
site/teci-standalone.html

# Commercial docs (pricing sheet, ad order form, sales SOP).
# The public repo must stay public, so this playbook stays local.
business/

# Local helper that pushes via the GitHub API (needs a token, keep it local)\nscripts/upload_github.py\n\n# Render output
render.png

# Local chart preview (dump_svg.js + preview_chart.py)
build/

# Editors
.vscode/
.idea/
.DS_Store
